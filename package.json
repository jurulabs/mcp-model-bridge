{
  "name": "@jurulabs/mcp-model-bridge",
  "version": "0.1.0",
  "description": "MCP server that runs .agent.md definitions against a model you name, instead of the one the IDE session happens to use.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "copilot",
    "agents",
    "llm-routing"
  ],
  "bin": {
    "mcp-model-bridge": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "model-policy.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
